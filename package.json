{
  "name": "projects-ii-game-template",
  "version": "1.0.0",
  "private": true,
  "description": "Projects II classroom starter: Phaser 3 + TypeScript + Vite + Supabase, deployable to GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:school": "npm config set strict-ssl false && npm install && npm config set strict-ssl true"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}
