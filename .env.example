# Local development only.
# Copy to `.env` and fill in YOUR personal Supabase project:
#   cp .env.example .env
#
# Each student uses their own local-dev project here.
# The class production project goes in GitHub Actions variables
# (not in this file) for the GitHub Pages deploy.
#
# These two values are public (safe to use in the browser).
# Do not put the secret key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
