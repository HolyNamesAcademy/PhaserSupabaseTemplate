# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# These values are SAFE to expose in the browser.
# They are public client credentials. Security comes from
# Supabase Auth + Row Level Security, not from hiding these keys.
#
# Never put the Supabase service_role key (or any secret key) here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
